<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jesse.skillcurator</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>~/.claude/skills/skill-curator/run-curator.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:~/.omnara/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>~/.local/state/jesseos-skills/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>~/.local/state/jesseos-skills/launchd.err.log</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
