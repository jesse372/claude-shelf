<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.jesse.project-backup</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>~/.claude/skills/project-backup/scripts/backup_projects.sh</string></array>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>~/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string><key>HOME</key><string>~</string></dict>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>4</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key><string>~/.project-backup.log</string>
  <key>StandardErrorPath</key><string>~/.project-backup.log</string>
</dict></plist>
